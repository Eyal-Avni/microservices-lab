# Normalize line endings: LF in the repository and the working tree.
# Windows-only scripts keep CRLF so cmd.exe / PowerShell run them correctly.
* text=auto eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never diff or normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.dll binary
*.exe binary
*.woff binary
*.woff2 binary
